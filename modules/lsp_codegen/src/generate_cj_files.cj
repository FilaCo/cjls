package lsp_codegen

import std.ast.*
import std.collection.ArrayList
import std.fs.Path
import std.io.{ByteBuffer, StringWriter, readToEnd}

struct CjFile {
    CjFile(let path: Path, let contents: String) {}
}

func generateCjFiles(cfg: Config, mm: MetaModel): Array<CjFile> {
    generateEnumerationFiles(cfg, mm).concat(
        [
            generateUriFile(cfg, mm),
            generateSpecFile(cfg, mm)
        ]
    )
}

private func generateUriFile(cfg: Config, mm: MetaModel) {
    let byteBuffer = ByteBuffer()
    let cjEmitter = CjEmitter(byteBuffer)
    cjEmitter.preambled(mm.metaData.version, Token(PACKAGE_IDENTIFIER, cfg.outputPackage)) {
        => cjEmitter.emit(quote(
public type URI = String
public type DocumentUri = String
))
    }
    cjEmitter.flush()
    let contents = unsafe { String.fromUtf8(readToEnd(byteBuffer)) }
    let path = cfg.outputDir.join("uri.cj")
    CjFile(path, contents)
}

private func generateSpecFile(cfg: Config, mm: MetaModel) {
    let byteBuffer = ByteBuffer()
    let cjEmitter = CjEmitter(byteBuffer)
    cjEmitter.preambled(mm.metaData.version, Token(PACKAGE_IDENTIFIER, cfg.outputPackage)) {
        =>
            cjEmitter.emit(DocComment(lines: ["Indicates in which direction a message is sent in the protocol."]))
            cjEmitter.emitln(
                quote(
public enum MessageDirection {
    | ClientToServer
    | ServerToClient
    | Both
}
        ))
            cjEmitter.emitln(
                quote(
public interface LspRequestSpec<P, R> {
    static prop METHOD: String
    static prop DIRECTION: MessageDirection
}

public interface LspNotificationSpec<P> {
    static prop METHOD: String
    static prop DIRECTION: MessageDirection
}
))
    }
    cjEmitter.flush()
    let contents = unsafe { String.fromUtf8(readToEnd(byteBuffer)) }
    let path = cfg.outputDir.join("spec.cj")
    CjFile(path, contents)
}

private func generateEnumerationFiles(cfg: Config, mm: MetaModel): Array<CjFile> {
    mm.enumerations.filterMap {enumeration: Enumeration => resolveEnum(cfg, enumeration)}.map {
        enumIr: EnumIr =>
            let byteBuffer = ByteBuffer()
            let cjEmitter = CjEmitter(byteBuffer)
            cjEmitter.preambled(mm.metaData.version, Token(PACKAGE_IDENTIFIER, cfg.outputPackage)) {
                => cjEmitter.emitEnum(enumIr)
            }
            cjEmitter.flush()
            let contents = unsafe { String.fromUtf8(readToEnd(byteBuffer)) }
            let path = cfg.outputDir.join(enumIr.ident.toAsciiLowerSnakeCase()).join(".cj")
            CjFile(path, contents)
    }
}

extend CjEmitter {
    func preambled(version: String, outputPackage: Token, body: () -> Unit): Unit {
        emit(DocComment(lines: ["Generated by lsp_codegen from metaModel.json ${version}."]))
        emitln(quote(
package $outputPackage

import stdx.serialization.serialization.*
import stdxx.*
        ))

        body()
    }
}
