package lsp_codegen

import std.collection.ArrayList
import std.fs.Path

struct CjFile {
    CjFile(let path!: Path, let content!: String) {}
}

func generateCjFiles(cfg: Config, mm: MetaModel): Array<CjFile> {
    // let enumerationFiles = 
    // generateEnumerationFiles(cfg, mm)
    [
        generateUriFile(cfg, mm),
        generateSpecFile(cfg, mm)
    ]
}

private func generateUriFile(cfg: Config, mm: MetaModel): CjFile {
    let path = cfg.outputDir.join("uri.cj")
    let preamble = generatePreamble(version: mm.metaData.version, outputPackage: cfg.outputPackage)
    let content = """
${preamble}
public type URI = String
public type DocumentUri = String
"""

    CjFile(path: path, content: content)
}

private func generateSpecFile(cfg: Config, mm: MetaModel): CjFile {
    let path = cfg.outputDir.join("spec.cj")
    let preamble = generatePreamble(version: mm.metaData.version, outputPackage: cfg.outputPackage)
    let content = """
${preamble}
/**
 * Indicates in which direction a message is sent in the protocol.
 */
public enum MessageDirection {
    | ClientToServer
    | ServerToClient
    | Both
}

public interface LspRequestSpec<P, R> {
    static prop METHOD: String
    static prop DIRECTION: MessageDirection
}

public interface LspNotificationSpec<P> {
    static prop METHOD: String
    static prop DIRECTION: MessageDirection
}
"""

    CjFile(path: path, content: content)
}

private func generateEnumerationFiles(cfg: Config, mm: MetaModel): Array<CjFile> {
    return []
    // mm.enumerations.flatMap{ it: Enumeration => resolveEnum(it) }.map {ir => 
    //     let sb = StringBuilder()
    //     let cjWriter = CjWriter(sb)
    //     emitEnum(cjWriter, ir)
    //     let fileName = Path(ir.ident.toAsciiSnakeLowerCase()).join(".cj")
    //     CjFile(cfg.outputDir.join(fileName), sb.toString())
    // }
}

private func generatePreamble(version!: String, outputPackage!: String): String {
    """
// Generated by lsp_codegen from metaModel.json ${version}.
package ${outputPackage}

import stdx.serialization.serialization.*
import stdxx.*
"""
}
