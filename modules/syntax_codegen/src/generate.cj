package syntax_codegen

import std.fs.*
import std.process.*

struct GeneratedFile {
    GeneratedFile(let path: Path, let contents: String) {}
}

struct Generated {
    Generated(let files: Array<GeneratedFile>, let model: Model) {}
}

/**
 * What the kinds file at `path` and its grammar make: the kinds and the typed views, where they belong, before
 * `cjfmt` has had them.
 */
func generate(path: Path): Generated {
    let inputs = Inputs.load(path)
    let model = buildModel(inputs.kinds, inputs.grammar)
    let header = "// Generated by `syntax_codegen` from `${path.fileName}` and `${inputs.kinds.grammar}`: do not edit."
    Generated(
        [
            GeneratedFile(
                inputs.dir.join(inputs.kinds.kindsOutput),
                emitKinds(model, header, inputs.kinds.kindsPackage)
            ),
            GeneratedFile(
                inputs.dir.join(inputs.kinds.astOutput),
                emitAst(model, header, inputs.kinds.astPackage)
            )
        ],
        model
    )
}

/**
 * Writes `contents` to `path` as `cjfmt` formats it: what is checked in is exactly what is generated.
 *
 * @throws IllegalStateException - if `cjfmt` fails, which it does on code that does not parse
 */
func writeFormatted(path: Path, contents: String): Unit {
    let dir = path.parent
    if (!dir.isEmpty() && !exists(dir)) {
        Directory.create(dir, recursive: true)
    }
    File.writeTo(path, contents.toArray())
    let status = execute("cjfmt", ["-f", path.toString(), "-o", path.toString()], stdOut: Discard, stdErr: Discard)
    if (status != 0) {
        throw IllegalStateException("cjfmt failed on ${path}")
    }
}
