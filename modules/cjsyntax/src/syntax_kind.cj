            case BinExpr => "BinExpr"
            case IsExpr => "IsExpr"
            case AsExpr => "AsExpr"
            case RangeExpr => "RangeExpr"
            case PostfixExpr => "PostfixExpr"
            case ParenExpr => "ParenExpr"
            case TupleExpr => "TupleExpr"
            case ArrayExpr => "ArrayExpr"
            case UnitExpr => "UnitExpr"
            case IfExpr => "IfExpr"
            case LetExpr => "LetExpr"
            case MatchExpr => "MatchExpr"
            case MatchBody => "MatchBody"
            case MatchCase => "MatchCase"
            case Guard => "Guard"
            case TryExpr => "TryExpr"
            case ResourceList => "ResourceList"
            case ResourceDecl => "ResourceDecl"
            case CatchClause => "CatchClause"
            case FinallyClause => "FinallyClause"
            case ForInExpr => "ForInExpr"
            case WhileExpr => "WhileExpr"
            case DoWhileExpr => "DoWhileExpr"
            case ThrowExpr => "ThrowExpr"
            case ReturnExpr => "ReturnExpr"
            case BreakExpr => "BreakExpr"
            case ContinueExpr => "ContinueExpr"
            case SpawnExpr => "SpawnExpr"
            case SynchronizedExpr => "SynchronizedExpr"
            case UnsafeExpr => "UnsafeExpr"
            case LambdaExpr => "LambdaExpr"
            case LambdaParamList => "LambdaParamList"
            case LambdaParam => "LambdaParam"
            case ThisExpr => "ThisExpr"
            case SuperExpr => "SuperExpr"
            case WildcardExpr => "WildcardExpr"
            case TypeConvExpr => "TypeConvExpr"
            case PrimTypeExpr => "PrimTypeExpr"
            case VArrayExpr => "VArrayExpr"
            case QuoteExpr => "QuoteExpr"
            case QuoteInterpolation => "QuoteInterpolation"
            case MacroExpandExpr => "MacroExpandExpr"
            case MacroAttr => "MacroAttr"
            case MacroArgs => "MacroArgs"
        }
    }

    /**
     * What the parser skips.
     */
    public func isTrivia(): Bool {
        match (this) {
            case Whitespace | Newline | LineComment | BlockComment => true
            case _ => false
        }
    }

    /**
     * A keyword, contextual or not.
     */
    public func isKeyword(): Bool {
        match (this) {
            case Int8Kw | Int16Kw | Int32Kw | Int64Kw | IntNativeKw | UInt8Kw | UInt16Kw | UInt32Kw | UInt64Kw
                | UIntNativeKw | Float16Kw | Float32Kw | Float64Kw | RuneKw | BoolKw | NothingKw | UnitKw | StructKw
                | EnumKw | VArrayKw | ThisTypeKw | PackageKw | ImportKw | ClassKw | InterfaceKw | FuncKw | MacroKw
                | QuoteKw | LetKw | VarKw | ConstKw | TypeKw | InitKw | ThisKw | SuperKw | IfKw | ElseKw | CaseKw
                | TryKw | CatchKw | FinallyKw | ForKw | DoKw | WhileKw | ThrowKw | ReturnKw | ContinueKw | BreakKw
                | InKw | MatchKw | WhereKw | ExtendKw | WithKw | PropKw | StaticKw | PublicKw | PrivateKw | InternalKw
                | ProtectedKw | OverrideKw | RedefKw | AbstractKw | SealedKw | OpenKw | ForeignKw | InoutKw | MutKw
                | UnsafeKw | OperatorKw | SpawnKw | SynchronizedKw | MainKw | IsKw | AsKw | TrueKw | FalseKw | CommonKw
                | SpecificKw | FeaturesKw => true
            case _ => false
        }
    }

    /**
     * A keyword that is a name wherever a name fits.
     */
    public func isContextualKeyword(): Bool {
        match (this) {
            case PublicKw | PrivateKw | InternalKw | ProtectedKw | OverrideKw | RedefKw | AbstractKw | SealedKw | OpenKw
                | CommonKw | SpecificKw | FeaturesKw => true
            case _ => false
        }
    }

    /**
     * Punctuation, the kinds the parser glues included.
     */
    public func isPunctuation(): Bool {
        match (this) {
            case Dot | Comma | LParen | RParen | LBracket | RBracket | LBrace | RBrace | StarStar | Star | Percent
                | Slash | Plus | Minus | PlusPlus | MinusMinus | AmpAmp | PipePipe | PipeGt | TildeGt | Bang | Amp
                | Pipe | Caret | Tilde | LtLt | Colon | ColonColon | Semicolon | Eq | PlusEq | MinusEq | StarEq
                | StarStarEq | SlashEq | PercentEq | AmpAmpEq | PipePipeEq | AmpEq | PipeEq | CaretEq | LtLtEq | Arrow
                | LArrow | FatArrow | DotDot | DotDotEq | DotDotDot | Hash | At | AtBang | Question | Lt | Gt | LtEq
                | LtColon | EqEq | BangEq | Dollar | Backslash | GtGt | GtEq | GtGtEq | QuestionQuestion => true
            case _ => false
        }
    }

    /**
     * The text of a token spelled one way only.
     */
    public func fixedText(): ?String {
        match (this) {
            case Dot => "."
            case Comma => ","
            case LParen => "("
            case RParen => ")"
            case LBracket => "["
            case RBracket => "]"
            case LBrace => "{"
            case RBrace => "}"
            case StarStar => "**"
            case Star => "*"
            case Percent => "%"
            case Slash => "/"
            case Plus => "+"
            case Minus => "-"
            case PlusPlus => "++"
            case MinusMinus => "--"
            case AmpAmp => "&&"
            case PipePipe => "||"
            case PipeGt => "|>"
            case TildeGt => "~>"
            case Bang => "!"
            case Amp => "&"
            case Pipe => "|"
            case Caret => "^"
            case Tilde => "~"
            case LtLt => "<<"
            case Colon => ":"
            case ColonColon => "::"
            case Semicolon => ";"
            case Eq => "="
            case PlusEq => "+="
            case MinusEq => "-="
            case StarEq => "*="
            case StarStarEq => "**="
            case SlashEq => "/="
            case PercentEq => "%="
            case AmpAmpEq => "&&="
            case PipePipeEq => "||="
            case AmpEq => "&="
            case PipeEq => "|="
            case CaretEq => "^="
            case LtLtEq => "<<="
            case Arrow => "->"
            case LArrow => "<-"
            case FatArrow => "=>"
            case DotDot => ".."
            case DotDotEq => "..="
            case DotDotDot => "..."
            case Hash => "#"
            case At => "@"
            case AtBang => "@!"
            case Question => "?"
            case Lt => "<"
            case Gt => ">"
            case LtEq => "<="
            case LtColon => "<:"
            case EqEq => "=="
            case BangEq => "!="
            case Dollar => "\$"
            case Backslash => "\\"
            case GtGt => ">>"
            case GtEq => ">="
            case GtGtEq => ">>="
            case QuestionQuestion => "??"
            case InterpolationStart => "\${"
            case InterpolationEnd => "}"
            case Underscore => "_"
            case Int8Kw => "Int8"
            case Int16Kw => "Int16"
            case Int32Kw => "Int32"
            case Int64Kw => "Int64"
            case IntNativeKw => "IntNative"
            case UInt8Kw => "UInt8"
            case UInt16Kw => "UInt16"
            case UInt32Kw => "UInt32"
            case UInt64Kw => "UInt64"
            case UIntNativeKw => "UIntNative"
            case Float16Kw => "Float16"
            case Float32Kw => "Float32"
            case Float64Kw => "Float64"
            case RuneKw => "Rune"
            case BoolKw => "Bool"
            case NothingKw => "Nothing"
            case UnitKw => "Unit"
            case StructKw => "struct"
            case EnumKw => "enum"
            case VArrayKw => "VArray"
            case ThisTypeKw => "This"
            case PackageKw => "package"
            case ImportKw => "import"
            case ClassKw => "class"
            case InterfaceKw => "interface"
            case FuncKw => "func"
            case MacroKw => "macro"
            case QuoteKw => "quote"
            case LetKw => "let"
            case VarKw => "var"
            case ConstKw => "const"
            case TypeKw => "type"
            case InitKw => "init"
            case ThisKw => "this"
            case SuperKw => "super"
            case IfKw => "if"
            case ElseKw => "else"
            case CaseKw => "case"
            case TryKw => "try"
            case CatchKw => "catch"
            case FinallyKw => "finally"
            case ForKw => "for"
            case DoKw => "do"
            case WhileKw => "while"
            case ThrowKw => "throw"
            case ReturnKw => "return"
            case ContinueKw => "continue"
            case BreakKw => "break"
            case InKw => "in"
            case MatchKw => "match"
            case WhereKw => "where"
            case ExtendKw => "extend"
            case WithKw => "with"
            case PropKw => "prop"
            case StaticKw => "static"
            case PublicKw => "public"
            case PrivateKw => "private"
            case InternalKw => "internal"
            case ProtectedKw => "protected"
            case OverrideKw => "override"
            case RedefKw => "redef"
            case AbstractKw => "abstract"
            case SealedKw => "sealed"
            case OpenKw => "open"
            case ForeignKw => "foreign"
            case InoutKw => "inout"
            case MutKw => "mut"
            case UnsafeKw => "unsafe"
            case OperatorKw => "operator"
            case SpawnKw => "spawn"
            case SynchronizedKw => "synchronized"
            case MainKw => "main"
            case IsKw => "is"
            case AsKw => "as"
            case TrueKw => "true"
            case FalseKw => "false"
            case CommonKw => "common"
            case SpecificKw => "specific"
            case FeaturesKw => "features"
            case _ => None
        }
    }

    /**
     * The keyword, or other word, spelled `text`.
     */
    public static func keyword(text: String): ?SyntaxKind {
        match (text) {
            case "_" => Underscore
            case "Int8" => Int8Kw
            case "Int16" => Int16Kw
            case "Int32" => Int32Kw
            case "Int64" => Int64Kw
            case "IntNative" => IntNativeKw
            case "UInt8" => UInt8Kw
            case "UInt16" => UInt16Kw
            case "UInt32" => UInt32Kw
            case "UInt64" => UInt64Kw
            case "UIntNative" => UIntNativeKw
            case "Float16" => Float16Kw
            case "Float32" => Float32Kw
            case "Float64" => Float64Kw
            case "Rune" => RuneKw
            case "Bool" => BoolKw
            case "Nothing" => NothingKw
            case "Unit" => UnitKw
            case "struct" => StructKw
            case "enum" => EnumKw
            case "VArray" => VArrayKw
            case "This" => ThisTypeKw
            case "package" => PackageKw
            case "import" => ImportKw
            case "class" => ClassKw
            case "interface" => InterfaceKw
            case "func" => FuncKw
            case "macro" => MacroKw
            case "quote" => QuoteKw
            case "let" => LetKw
            case "var" => VarKw
            case "const" => ConstKw
            case "type" => TypeKw
            case "init" => InitKw
            case "this" => ThisKw
            case "super" => SuperKw
            case "if" => IfKw
            case "else" => ElseKw
            case "case" => CaseKw
            case "try" => TryKw
            case "catch" => CatchKw
            case "finally" => FinallyKw
            case "for" => ForKw
            case "do" => DoKw
            case "while" => WhileKw
            case "throw" => ThrowKw
            case "return" => ReturnKw
            case "continue" => ContinueKw
            case "break" => BreakKw
            case "in" => InKw
            case "match" => MatchKw
            case "where" => WhereKw
            case "extend" => ExtendKw
            case "with" => WithKw
            case "prop" => PropKw
            case "static" => StaticKw
            case "public" => PublicKw
            case "private" => PrivateKw
            case "internal" => InternalKw
            case "protected" => ProtectedKw
            case "override" => OverrideKw
            case "redef" => RedefKw
            case "abstract" => AbstractKw
            case "sealed" => SealedKw
            case "open" => OpenKw
            case "foreign" => ForeignKw
            case "inout" => InoutKw
            case "mut" => MutKw
            case "unsafe" => UnsafeKw
            case "operator" => OperatorKw
            case "spawn" => SpawnKw
            case "synchronized" => SynchronizedKw
            case "main" => MainKw
            case "is" => IsKw
            case "as" => AsKw
            case "true" => TrueKw
            case "false" => FalseKw
            case "common" => CommonKw
            case "specific" => SpecificKw
            case "features" => FeaturesKw
            case _ => None
        }
    }
}

extend SyntaxKind <: Kind<SyntaxKind> {}

/**
 * The punctuation the lexer cuts out of the text, the longest first: it takes the first that matches.
 */
let LEXED_PUNCTUATION: Array<(Array<Byte>, SyntaxKind)> = [
    ("**=".toArray(), StarStarEq),
    ("&&=".toArray(), AmpAmpEq),
    ("||=".toArray(), PipePipeEq),
    ("<<=".toArray(), LtLtEq),
    ("..=".toArray(), DotDotEq),
    ("...".toArray(), DotDotDot),
    ("**".toArray(), StarStar),
    ("++".toArray(), PlusPlus),
    ("--".toArray(), MinusMinus),
    ("&&".toArray(), AmpAmp),
    ("||".toArray(), PipePipe),
    ("|>".toArray(), PipeGt),
    ("~>".toArray(), TildeGt),
    ("<<".toArray(), LtLt),
    ("::".toArray(), ColonColon),
    ("+=".toArray(), PlusEq),
    ("-=".toArray(), MinusEq),
    ("*=".toArray(), StarEq),
    ("/=".toArray(), SlashEq),
    ("%=".toArray(), PercentEq),
    ("&=".toArray(), AmpEq),
    ("|=".toArray(), PipeEq),
    ("^=".toArray(), CaretEq),
    ("->".toArray(), Arrow),
    ("<-".toArray(), LArrow),
    ("=>".toArray(), FatArrow),
    ("..".toArray(), DotDot),
    ("@!".toArray(), AtBang),
    ("<=".toArray(), LtEq),
    ("<:".toArray(), LtColon),
    ("==".toArray(), EqEq),
    ("!=".toArray(), BangEq),
    (".".toArray(), Dot),
    (",".toArray(), Comma),
    ("(".toArray(), LParen),
    (")".toArray(), RParen),
    ("[".toArray(), LBracket),
    ("]".toArray(), RBracket),
    ("{".toArray(), LBrace),
    ("}".toArray(), RBrace),
    ("*".toArray(), Star),
    ("%".toArray(), Percent),
    ("/".toArray(), Slash),
    ("+".toArray(), Plus),
    ("-".toArray(), Minus),
    ("!".toArray(), Bang),
    ("&".toArray(), Amp),
    ("|".toArray(), Pipe),
    ("^".toArray(), Caret),
    ("~".toArray(), Tilde),
    (":".toArray(), Colon),
    (";".toArray(), Semicolon),
    ("=".toArray(), Eq),
    ("#".toArray(), Hash),
    ("@".toArray(), At),
    ("?".toArray(), Question),
    ("<".toArray(), Lt),
    (">".toArray(), Gt),
    ("\$".toArray(), Dollar),
    ("\\".toArray(), Backslash)
]
