public enum Decl <: AstNode<SyntaxKind, Decl> & Equatable<Decl> & Hashable & ToString {
    | AsFuncDecl(FuncDecl)
    | AsMainDecl(MainDecl)
    | AsMacroDecl(MacroDecl)
    | AsClassDecl(ClassDecl)
    | AsInterfaceDecl(InterfaceDecl)
    | AsStructDecl(StructDecl)
    | AsEnumDecl(EnumDecl)
    | AsExtendDecl(ExtendDecl)
    | AsTypeAliasDecl(TypeAliasDecl)
    | AsVarDecl(VarDecl)
    | AsPropDecl(PropDecl)
    | AsInitDecl(InitDecl)
    | AsFinalizerDecl(FinalizerDecl)
    | AsPrimaryInitDecl(PrimaryInitDecl)
    | AsEnumCtor(EnumCtor)
    | AsForeignBlock(ForeignBlock)
    | AsMacroExpandDecl(MacroExpandDecl)

    public static func canCast(kind: SyntaxKind): Bool {
        match (kind) {
            case SyntaxKind.FuncDecl | SyntaxKind.MainDecl | SyntaxKind.MacroDecl | SyntaxKind.ClassDecl
                | SyntaxKind.InterfaceDecl | SyntaxKind.StructDecl | SyntaxKind.EnumDecl | SyntaxKind.ExtendDecl
                | SyntaxKind.TypeAliasDecl | SyntaxKind.VarDecl | SyntaxKind.PropDecl | SyntaxKind.InitDecl
                | SyntaxKind.FinalizerDecl | SyntaxKind.PrimaryInitDecl | SyntaxKind.EnumCtor | SyntaxKind.ForeignBlock
                | SyntaxKind.MacroExpandDecl => true
            case _ => false
        }
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?Decl {
        match (node.kind) {
            case SyntaxKind.FuncDecl => AsFuncDecl(FuncDecl(node))
            case SyntaxKind.MainDecl => AsMainDecl(MainDecl(node))
            case SyntaxKind.MacroDecl => AsMacroDecl(MacroDecl(node))
            case SyntaxKind.ClassDecl => AsClassDecl(ClassDecl(node))
            case SyntaxKind.InterfaceDecl => AsInterfaceDecl(InterfaceDecl(node))
            case SyntaxKind.StructDecl => AsStructDecl(StructDecl(node))
            case SyntaxKind.EnumDecl => AsEnumDecl(EnumDecl(node))
            case SyntaxKind.ExtendDecl => AsExtendDecl(ExtendDecl(node))
            case SyntaxKind.TypeAliasDecl => AsTypeAliasDecl(TypeAliasDecl(node))
            case SyntaxKind.VarDecl => AsVarDecl(VarDecl(node))
            case SyntaxKind.PropDecl => AsPropDecl(PropDecl(node))
            case SyntaxKind.InitDecl => AsInitDecl(InitDecl(node))
            case SyntaxKind.FinalizerDecl => AsFinalizerDecl(FinalizerDecl(node))
            case SyntaxKind.PrimaryInitDecl => AsPrimaryInitDecl(PrimaryInitDecl(node))
            case SyntaxKind.EnumCtor => AsEnumCtor(EnumCtor(node))
            case SyntaxKind.ForeignBlock => AsForeignBlock(ForeignBlock(node))
            case SyntaxKind.MacroExpandDecl => AsMacroExpandDecl(MacroExpandDecl(node))
            case _ => None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            match (this) {
                case AsFuncDecl(it) => it.syntax
                case AsMainDecl(it) => it.syntax
                case AsMacroDecl(it) => it.syntax
                case AsClassDecl(it) => it.syntax
                case AsInterfaceDecl(it) => it.syntax
                case AsStructDecl(it) => it.syntax
                case AsEnumDecl(it) => it.syntax
                case AsExtendDecl(it) => it.syntax
                case AsTypeAliasDecl(it) => it.syntax
                case AsVarDecl(it) => it.syntax
                case AsPropDecl(it) => it.syntax
                case AsInitDecl(it) => it.syntax
                case AsFinalizerDecl(it) => it.syntax
                case AsPrimaryInitDecl(it) => it.syntax
                case AsEnumCtor(it) => it.syntax
                case AsForeignBlock(it) => it.syntax
                case AsMacroExpandDecl(it) => it.syntax
            }
        }
    }

    public operator func ==(other: Decl): Bool {
        syntax == other.syntax
    }

    public operator func !=(other: Decl): Bool {
        syntax != other.syntax
    }

    public func hashCode(): Int64 {
        syntax.hashCode()
    }

    public func toString(): String {
        syntax.text()
    }
}

