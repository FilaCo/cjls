    RefExpr(let node: SyntaxNode<SyntaxKind>) {}

    public static func canCast(kind: SyntaxKind): Bool {
        kind == SyntaxKind.RefExpr
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?RefExpr {
        if (canCast(node.kind)) {
            RefExpr(node)
        } else {
            None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            node
        }
    }

    public func nameRef(): ?NameRef {
        astChild<SyntaxKind, NameRef>(node)
    }

    public func typeArgList(): ?TypeArgList {
        astChild<SyntaxKind, TypeArgList>(node)
    }

    public func toString(): String {
        node.text()
    }
}

