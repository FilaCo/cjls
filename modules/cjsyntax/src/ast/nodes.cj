/**
 * `MacroExpandDecl` too: a macro call on a declaration may stand for a value (`var f = @M func g() {}`), though
 * no operator may follow it
 */
public enum Expr <: AstNode<SyntaxKind, Expr> & Equatable<Expr> & Hashable & ToString {
    | AsLiteral(Literal)
    | AsStringLit(StringLit)
    | AsRefExpr(RefExpr)
    | AsMemberAccessExpr(MemberAccessExpr)
    | AsCallExpr(CallExpr)
    | AsTrailingLambdaExpr(TrailingLambdaExpr)
    | AsIndexExpr(IndexExpr)
    | AsOptionalExpr(OptionalExpr)
    | AsUnaryExpr(UnaryExpr)
    | AsBinExpr(BinExpr)
    | AsIsExpr(IsExpr)
    | AsAsExpr(AsExpr)
    | AsRangeExpr(RangeExpr)
    | AsPostfixExpr(PostfixExpr)
    | AsParenExpr(ParenExpr)
    | AsTupleExpr(TupleExpr)
    | AsArrayExpr(ArrayExpr)
    | AsUnitExpr(UnitExpr)
    | AsIfExpr(IfExpr)
    | AsLetExpr(LetExpr)
    | AsMatchExpr(MatchExpr)
    | AsTryExpr(TryExpr)
    | AsForInExpr(ForInExpr)
    | AsWhileExpr(WhileExpr)
    | AsDoWhileExpr(DoWhileExpr)
    | AsThrowExpr(ThrowExpr)
    | AsReturnExpr(ReturnExpr)
    | AsBreakExpr(BreakExpr)
    | AsContinueExpr(ContinueExpr)
    | AsSpawnExpr(SpawnExpr)
    | AsSynchronizedExpr(SynchronizedExpr)
    | AsUnsafeExpr(UnsafeExpr)
    | AsLambdaExpr(LambdaExpr)
    | AsThisExpr(ThisExpr)
    | AsSuperExpr(SuperExpr)
    | AsWildcardExpr(WildcardExpr)
    | AsTypeConvExpr(TypeConvExpr)
    | AsPrimTypeExpr(PrimTypeExpr)
    | AsVArrayExpr(VArrayExpr)
    | AsQuoteExpr(QuoteExpr)
    | AsMacroExpandExpr(MacroExpandExpr)
    | AsMacroExpandDecl(MacroExpandDecl)

    public static func canCast(kind: SyntaxKind): Bool {
        match (kind) {
            case SyntaxKind.Literal | SyntaxKind.StringLit | SyntaxKind.RefExpr | SyntaxKind.MemberAccessExpr
                | SyntaxKind.CallExpr | SyntaxKind.TrailingLambdaExpr | SyntaxKind.IndexExpr | SyntaxKind.OptionalExpr
                | SyntaxKind.UnaryExpr | SyntaxKind.BinExpr | SyntaxKind.IsExpr | SyntaxKind.AsExpr
                | SyntaxKind.RangeExpr | SyntaxKind.PostfixExpr | SyntaxKind.ParenExpr | SyntaxKind.TupleExpr
                | SyntaxKind.ArrayExpr | SyntaxKind.UnitExpr | SyntaxKind.IfExpr | SyntaxKind.LetExpr
                | SyntaxKind.MatchExpr | SyntaxKind.TryExpr | SyntaxKind.ForInExpr | SyntaxKind.WhileExpr
                | SyntaxKind.DoWhileExpr | SyntaxKind.ThrowExpr | SyntaxKind.ReturnExpr | SyntaxKind.BreakExpr
                | SyntaxKind.ContinueExpr | SyntaxKind.SpawnExpr | SyntaxKind.SynchronizedExpr | SyntaxKind.UnsafeExpr
                | SyntaxKind.LambdaExpr | SyntaxKind.ThisExpr | SyntaxKind.SuperExpr | SyntaxKind.WildcardExpr
                | SyntaxKind.TypeConvExpr | SyntaxKind.PrimTypeExpr | SyntaxKind.VArrayExpr | SyntaxKind.QuoteExpr
                | SyntaxKind.MacroExpandExpr | SyntaxKind.MacroExpandDecl => true
            case _ => false
        }
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?Expr {
        match (node.kind) {
            case SyntaxKind.Literal => AsLiteral(Literal(node))
            case SyntaxKind.StringLit => AsStringLit(StringLit(node))
            case SyntaxKind.RefExpr => AsRefExpr(RefExpr(node))
            case SyntaxKind.MemberAccessExpr => AsMemberAccessExpr(MemberAccessExpr(node))
            case SyntaxKind.CallExpr => AsCallExpr(CallExpr(node))
            case SyntaxKind.TrailingLambdaExpr => AsTrailingLambdaExpr(TrailingLambdaExpr(node))
            case SyntaxKind.IndexExpr => AsIndexExpr(IndexExpr(node))
            case SyntaxKind.OptionalExpr => AsOptionalExpr(OptionalExpr(node))
            case SyntaxKind.UnaryExpr => AsUnaryExpr(UnaryExpr(node))
            case SyntaxKind.BinExpr => AsBinExpr(BinExpr(node))
            case SyntaxKind.IsExpr => AsIsExpr(IsExpr(node))
            case SyntaxKind.AsExpr => AsAsExpr(AsExpr(node))
            case SyntaxKind.RangeExpr => AsRangeExpr(RangeExpr(node))
            case SyntaxKind.PostfixExpr => AsPostfixExpr(PostfixExpr(node))
            case SyntaxKind.ParenExpr => AsParenExpr(ParenExpr(node))
            case SyntaxKind.TupleExpr => AsTupleExpr(TupleExpr(node))
            case SyntaxKind.ArrayExpr => AsArrayExpr(ArrayExpr(node))
            case SyntaxKind.UnitExpr => AsUnitExpr(UnitExpr(node))
            case SyntaxKind.IfExpr => AsIfExpr(IfExpr(node))
            case SyntaxKind.LetExpr => AsLetExpr(LetExpr(node))
            case SyntaxKind.MatchExpr => AsMatchExpr(MatchExpr(node))
            case SyntaxKind.TryExpr => AsTryExpr(TryExpr(node))
            case SyntaxKind.ForInExpr => AsForInExpr(ForInExpr(node))
            case SyntaxKind.WhileExpr => AsWhileExpr(WhileExpr(node))
            case SyntaxKind.DoWhileExpr => AsDoWhileExpr(DoWhileExpr(node))
            case SyntaxKind.ThrowExpr => AsThrowExpr(ThrowExpr(node))
            case SyntaxKind.ReturnExpr => AsReturnExpr(ReturnExpr(node))
            case SyntaxKind.BreakExpr => AsBreakExpr(BreakExpr(node))
            case SyntaxKind.ContinueExpr => AsContinueExpr(ContinueExpr(node))
            case SyntaxKind.SpawnExpr => AsSpawnExpr(SpawnExpr(node))
            case SyntaxKind.SynchronizedExpr => AsSynchronizedExpr(SynchronizedExpr(node))
            case SyntaxKind.UnsafeExpr => AsUnsafeExpr(UnsafeExpr(node))
            case SyntaxKind.LambdaExpr => AsLambdaExpr(LambdaExpr(node))
            case SyntaxKind.ThisExpr => AsThisExpr(ThisExpr(node))
            case SyntaxKind.SuperExpr => AsSuperExpr(SuperExpr(node))
            case SyntaxKind.WildcardExpr => AsWildcardExpr(WildcardExpr(node))
            case SyntaxKind.TypeConvExpr => AsTypeConvExpr(TypeConvExpr(node))
            case SyntaxKind.PrimTypeExpr => AsPrimTypeExpr(PrimTypeExpr(node))
            case SyntaxKind.VArrayExpr => AsVArrayExpr(VArrayExpr(node))
            case SyntaxKind.QuoteExpr => AsQuoteExpr(QuoteExpr(node))
            case SyntaxKind.MacroExpandExpr => AsMacroExpandExpr(MacroExpandExpr(node))
            case SyntaxKind.MacroExpandDecl => AsMacroExpandDecl(MacroExpandDecl(node))
            case _ => None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            match (this) {
                case AsLiteral(it) => it.syntax
                case AsStringLit(it) => it.syntax
                case AsRefExpr(it) => it.syntax
                case AsMemberAccessExpr(it) => it.syntax
                case AsCallExpr(it) => it.syntax
                case AsTrailingLambdaExpr(it) => it.syntax
                case AsIndexExpr(it) => it.syntax
                case AsOptionalExpr(it) => it.syntax
                case AsUnaryExpr(it) => it.syntax
                case AsBinExpr(it) => it.syntax
                case AsIsExpr(it) => it.syntax
                case AsAsExpr(it) => it.syntax
                case AsRangeExpr(it) => it.syntax
                case AsPostfixExpr(it) => it.syntax
                case AsParenExpr(it) => it.syntax
                case AsTupleExpr(it) => it.syntax
                case AsArrayExpr(it) => it.syntax
                case AsUnitExpr(it) => it.syntax
                case AsIfExpr(it) => it.syntax
                case AsLetExpr(it) => it.syntax
                case AsMatchExpr(it) => it.syntax
                case AsTryExpr(it) => it.syntax
                case AsForInExpr(it) => it.syntax
                case AsWhileExpr(it) => it.syntax
                case AsDoWhileExpr(it) => it.syntax
                case AsThrowExpr(it) => it.syntax
                case AsReturnExpr(it) => it.syntax
                case AsBreakExpr(it) => it.syntax
                case AsContinueExpr(it) => it.syntax
                case AsSpawnExpr(it) => it.syntax
                case AsSynchronizedExpr(it) => it.syntax
                case AsUnsafeExpr(it) => it.syntax
                case AsLambdaExpr(it) => it.syntax
                case AsThisExpr(it) => it.syntax
                case AsSuperExpr(it) => it.syntax
                case AsWildcardExpr(it) => it.syntax
                case AsTypeConvExpr(it) => it.syntax
                case AsPrimTypeExpr(it) => it.syntax
                case AsVArrayExpr(it) => it.syntax
                case AsQuoteExpr(it) => it.syntax
                case AsMacroExpandExpr(it) => it.syntax
                case AsMacroExpandDecl(it) => it.syntax
            }
        }
    }

    public operator func ==(other: Expr): Bool {
        syntax == other.syntax
    }

    public operator func !=(other: Expr): Bool {
        syntax != other.syntax
    }

    public func hashCode(): Int64 {
        syntax.hashCode()
    }

    public func toString(): String {
        syntax.text()
    }
}

