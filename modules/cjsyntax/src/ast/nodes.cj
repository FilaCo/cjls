public enum Pattern <: AstNode<SyntaxKind, Pattern> & Equatable<Pattern> & Hashable & ToString {
    | AsWildcardPat(WildcardPat)
    | AsLiteralPat(LiteralPat)
    | AsBindPat(BindPat)
    | AsTypePat(TypePat)
    | AsTuplePat(TuplePat)
    | AsEnumPat(EnumPat)

    public static func canCast(kind: SyntaxKind): Bool {
        match (kind) {
            case SyntaxKind.WildcardPat | SyntaxKind.LiteralPat | SyntaxKind.BindPat | SyntaxKind.TypePat
                | SyntaxKind.TuplePat | SyntaxKind.EnumPat => true
            case _ => false
        }
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?Pattern {
        match (node.kind) {
            case SyntaxKind.WildcardPat => AsWildcardPat(WildcardPat(node))
            case SyntaxKind.LiteralPat => AsLiteralPat(LiteralPat(node))
            case SyntaxKind.BindPat => AsBindPat(BindPat(node))
            case SyntaxKind.TypePat => AsTypePat(TypePat(node))
            case SyntaxKind.TuplePat => AsTuplePat(TuplePat(node))
            case SyntaxKind.EnumPat => AsEnumPat(EnumPat(node))
            case _ => None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            match (this) {
                case AsWildcardPat(it) => it.syntax
                case AsLiteralPat(it) => it.syntax
                case AsBindPat(it) => it.syntax
                case AsTypePat(it) => it.syntax
                case AsTuplePat(it) => it.syntax
                case AsEnumPat(it) => it.syntax
            }
        }
    }

    public operator func ==(other: Pattern): Bool {
        syntax == other.syntax
    }

    public operator func !=(other: Pattern): Bool {
        syntax != other.syntax
    }

    public func hashCode(): Int64 {
        syntax.hashCode()
    }

    public func toString(): String {
        syntax.text()
    }
}

