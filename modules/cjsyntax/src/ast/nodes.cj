            case SyntaxKind.LiteralPat => AsLiteralPat(LiteralPat(node))
            case SyntaxKind.BindPat => AsBindPat(BindPat(node))
            case SyntaxKind.TypePat => AsTypePat(TypePat(node))
            case SyntaxKind.TuplePat => AsTuplePat(TuplePat(node))
            case SyntaxKind.EnumPat => AsEnumPat(EnumPat(node))
            case _ => None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            match (this) {
                case AsWildcardPat(it) => it.syntax
                case AsLiteralPat(it) => it.syntax
                case AsBindPat(it) => it.syntax
                case AsTypePat(it) => it.syntax
                case AsTuplePat(it) => it.syntax
                case AsEnumPat(it) => it.syntax
            }
        }
    }

    public operator func ==(other: Pattern): Bool {
        syntax == other.syntax
