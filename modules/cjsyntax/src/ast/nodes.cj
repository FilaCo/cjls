        }
    }

    public func op(): ?SyntaxToken<SyntaxKind> {
        astToken(node, RANGE_EXPR_OP)
    }

    public func colonToken(): ?SyntaxToken<SyntaxKind> {
        astToken(node, SyntaxKind.Colon)
    }

    public func toString(): String {
        node.text()
    }
}

