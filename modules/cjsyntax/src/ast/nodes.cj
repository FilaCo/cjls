public enum Stmt <: AstNode<SyntaxKind, Stmt> & Equatable<Stmt> & Hashable & ToString {
    | DeclStmt(Decl)
    | ExprStmt(Expr)

    public static func canCast(kind: SyntaxKind): Bool {
        match (kind) {
            case SyntaxKind.FuncDecl | SyntaxKind.MainDecl | SyntaxKind.MacroDecl | SyntaxKind.ClassDecl
                | SyntaxKind.InterfaceDecl | SyntaxKind.StructDecl | SyntaxKind.EnumDecl | SyntaxKind.ExtendDecl
                | SyntaxKind.TypeAliasDecl | SyntaxKind.VarDecl | SyntaxKind.PropDecl | SyntaxKind.InitDecl
                | SyntaxKind.FinalizerDecl | SyntaxKind.PrimaryInitDecl | SyntaxKind.EnumCtor | SyntaxKind.ForeignBlock
                | SyntaxKind.MacroExpandDecl | SyntaxKind.Literal | SyntaxKind.StringLit | SyntaxKind.RefExpr
                | SyntaxKind.MemberAccessExpr | SyntaxKind.CallExpr | SyntaxKind.TrailingLambdaExpr
                | SyntaxKind.IndexExpr | SyntaxKind.OptionalExpr | SyntaxKind.UnaryExpr | SyntaxKind.BinExpr
                | SyntaxKind.IsExpr | SyntaxKind.AsExpr | SyntaxKind.RangeExpr | SyntaxKind.PostfixExpr
                | SyntaxKind.ParenExpr | SyntaxKind.TupleExpr | SyntaxKind.ArrayExpr | SyntaxKind.UnitExpr
                | SyntaxKind.IfExpr | SyntaxKind.LetExpr | SyntaxKind.MatchExpr | SyntaxKind.TryExpr
                | SyntaxKind.ForInExpr | SyntaxKind.WhileExpr | SyntaxKind.DoWhileExpr | SyntaxKind.ThrowExpr
                | SyntaxKind.ReturnExpr | SyntaxKind.BreakExpr | SyntaxKind.ContinueExpr | SyntaxKind.SpawnExpr
                | SyntaxKind.SynchronizedExpr | SyntaxKind.UnsafeExpr | SyntaxKind.LambdaExpr | SyntaxKind.ThisExpr
                | SyntaxKind.SuperExpr | SyntaxKind.WildcardExpr | SyntaxKind.TypeConvExpr | SyntaxKind.PrimTypeExpr
                | SyntaxKind.VArrayExpr | SyntaxKind.QuoteExpr | SyntaxKind.MacroExpandExpr | SyntaxKind.MacroExpandDecl => true
            case _ => false
        }
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?Stmt {
        if (let Some(it) <- Decl.cast(node)) {
            return DeclStmt(it)
        }
        if (let Some(it) <- Expr.cast(node)) {
            return ExprStmt(it)
        }
        None
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            match (this) {
                case DeclStmt(it) => it.syntax
                case ExprStmt(it) => it.syntax
            }
        }
    }

    public operator func ==(other: Stmt): Bool {
        syntax == other.syntax
    }

    public operator func !=(other: Stmt): Bool {
        syntax != other.syntax
    }

    public func hashCode(): Int64 {
        syntax.hashCode()
    }

    public func toString(): String {
        syntax.text()
    }
}

public enum Type <: AstNode<SyntaxKind, Type> & Equatable<Type> & Hashable & ToString {
    | AsPathType(PathType)
    | AsPrimType(PrimType)
    | AsTupleType(TupleType)
    | AsParenType(ParenType)
    | AsFuncType(FuncType)
    | AsOptionType(OptionType)
    | AsThisType(ThisType)
    | AsVArrayType(VArrayType)

    public static func canCast(kind: SyntaxKind): Bool {
        match (kind) {
            case SyntaxKind.PathType | SyntaxKind.PrimType | SyntaxKind.TupleType | SyntaxKind.ParenType
                | SyntaxKind.FuncType | SyntaxKind.OptionType | SyntaxKind.ThisType | SyntaxKind.VArrayType => true
            case _ => false
        }
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?Type {
        match (node.kind) {
            case SyntaxKind.PathType => AsPathType(PathType(node))
            case SyntaxKind.PrimType => AsPrimType(PrimType(node))
            case SyntaxKind.TupleType => AsTupleType(TupleType(node))
            case SyntaxKind.ParenType => AsParenType(ParenType(node))
            case SyntaxKind.FuncType => AsFuncType(FuncType(node))
            case SyntaxKind.OptionType => AsOptionType(OptionType(node))
            case SyntaxKind.ThisType => AsThisType(ThisType(node))
            case SyntaxKind.VArrayType => AsVArrayType(VArrayType(node))
            case _ => None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            match (this) {
                case AsPathType(it) => it.syntax
                case AsPrimType(it) => it.syntax
                case AsTupleType(it) => it.syntax
                case AsParenType(it) => it.syntax
                case AsFuncType(it) => it.syntax
                case AsOptionType(it) => it.syntax
                case AsThisType(it) => it.syntax
                case AsVArrayType(it) => it.syntax
            }
        }
    }

    public operator func ==(other: Type): Bool {
        syntax == other.syntax
    }

    public operator func !=(other: Type): Bool {
        syntax != other.syntax
    }

    public func hashCode(): Int64 {
        syntax.hashCode()
    }

    public func toString(): String {
        syntax.text()
    }
}

