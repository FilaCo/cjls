    }

    public func atBangToken(): ?SyntaxToken<SyntaxKind> {
        astToken(node, SyntaxKind.AtBang)
    }

    public func nameRefs(): Iterator<NameRef> {
        astChildren<SyntaxKind, NameRef>(node)
    }

    public func dotToken(): ?SyntaxToken<SyntaxKind> {
        astToken(node, SyntaxKind.Dot)
    }

    public func macroAttr(): ?MacroAttr {
        astChild<SyntaxKind, MacroAttr>(node)
    }

    public func macroArgs(): ?MacroArgs {
        astChild<SyntaxKind, MacroArgs>(node)
    }

    public func macroExpandExpr(): ?MacroExpandExpr {
        astChild<SyntaxKind, MacroExpandExpr>(node)
    }

    public func toString(): String {
        node.text()
    }
}

/**
 * `[...]` after a macro name
 */
@Derive[Equatable, Hashable]
public struct MacroAttr <: AstNode<SyntaxKind, MacroAttr> & ToString {
    MacroAttr(let node: SyntaxNode<SyntaxKind>) {}

    public static func canCast(kind: SyntaxKind): Bool {
        kind == SyntaxKind.MacroAttr
    }

    public static func cast(node: SyntaxNode<SyntaxKind>): ?MacroAttr {
        if (canCast(node.kind)) {
            MacroAttr(node)
        } else {
            None
        }
    }

    public prop syntax: SyntaxNode<SyntaxKind> {
        get() {
            node
        }
    }

    public func lBracketToken(): ?SyntaxToken<SyntaxKind> {
        astToken(node, SyntaxKind.LBracket)
    }

    public func rBracketToken(): ?SyntaxToken<SyntaxKind> {
        astToken(node, SyntaxKind.RBracket)
    }

    public func toString(): String {
        node.text()
    }
}

